# Configuration reference only. These values are not automatically loaded.
# The offline test helper supplies its own temporary database and clean env.
BOT_SOURCE=main
SHOP_DB_FILE=./data/development.sqlite3

# Optional finance features remain disabled until configured by the operator.
LAVA_FINANCE_SHOP_ID=
LAVA_SUBSCRIPTIONS_FINANCE_SHOP_ID=

# Do not put Telegram tokens, payment secrets or panel credentials in Git.
# Runtime onboarding and a production deployment guide are not released yet.
